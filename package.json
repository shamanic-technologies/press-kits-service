{
  "name": "@anthropic-technologies/press-kits-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && pnpm generate:openapi",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@sentry/node": "^11.8.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "geoip-lite": "^2.0.3",
    "postgres": "^3.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "ip-address@<10.3.1": "^10.3.1",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "lodash@<4.18.0": "^4.18.0",
      "qs@<6.16.0": "^6.16.1",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "@esbuild-kit/core-utils>esbuild": "^0.28.1"
    }
  }
}
